{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.8 from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Loved by 12 lakh+ homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Stars",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Review Content",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
            "title": "Works like a charm",
            "content": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "reviewer_name": "Anita",
            "product_name": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
            "title": "Best dishwash ever",
            "content": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "reviewer_name": "Priya",
            "product_name": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
            "title": "Great product, great packaging",
            "content": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "reviewer_name": "Sunita",
            "product_name": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
            "title": "Dog friendly",
            "content": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "reviewer_name": "Rohit S.",
            "product_name": "Floor cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<section
  class="purelane-reviews"
  data-section-id="{{ section.id }}"
>
  <div class="purelane-reviews-wrap">

    {% if section.settings.kicker != blank
      or section.settings.rating_text != blank
      or section.settings.subtitle != blank
    %}
      <div class="purelane-reviews-header">

        {% if section.settings.kicker != blank %}
          <span class="purelane-reviews-kicker">
            {{ section.settings.kicker }}
          </span>
        {% endif %}

        {% if section.settings.rating_text != blank %}
          <span class="purelane-reviews-rating">
            <span class="purelane-reviews-stars">★★★★★</span>
            <strong>{{ section.settings.rating_text }}</strong>
          </span>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <span class="purelane-reviews-subtitle">
            {{ section.settings.subtitle }}
          </span>
        {% endif %}

      </div>
    {% endif %}

  </div>

  {% if section.blocks.size > 0 %}

    <div class="purelane-reviews-rail">

      <div class="purelane-reviews-track">

        {% for block in section.blocks %}
          <article
            class="purelane-review-card"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.stars != blank %}
              <div class="purelane-review-stars">
                {{ block.settings.stars }}
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="purelane-review-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.content != blank %}
              <p class="purelane-review-content">
                {{ block.settings.content }}
              </p>
            {% endif %}

            <div class="purelane-review-author">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m5 13 4 4L19 7"/>
              </svg>

              {% if block.settings.reviewer_name != blank %}
                <strong>{{ block.settings.reviewer_name }}</strong>
              {% endif %}

              {% if block.settings.product_name != blank %}
                <span>
                  · {{ block.settings.product_name }}
                </span>
              {% endif %}

            </div>
          </article>
        {% endfor %}


        {%- comment -%}
          Duplicate cards for seamless marquee animation.
        {%- endcomment -%}

        {% for block in section.blocks %}
          <article
            class="purelane-review-card"
            aria-hidden="true"
          >
            {% if block.settings.stars != blank %}
              <div class="purelane-review-stars">
                {{ block.settings.stars }}
              </div>
            {% endif %}

            {% if block.settings.title != blank %}
              <h3 class="purelane-review-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.content != blank %}
              <p class="purelane-review-content">
                {{ block.settings.content }}
              </p>
            {% endif %}

            <div class="purelane-review-author">

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m5 13 4 4L19 7"/>
              </svg>

              {% if block.settings.reviewer_name != blank %}
                <strong>{{ block.settings.reviewer_name }}</strong>
              {% endif %}

              {% if block.settings.product_name != blank %}
                <span>
                  · {{ block.settings.product_name }}
                </span>
              {% endif %}

            </div>
          </article>
        {% endfor %}

      </div>

    </div>

  {% else %}

    <div class="purelane-reviews-empty">
      Add review blocks from the Shopify theme editor.
    </div>

  {% endif %}
</section>


<style>

  .purelane-reviews-section {
    --review-bg: #f4f0fb;
    --review-paper: #241a3d;
    --review-paper-soft: rgba(36, 26, 61, 0.72);
    --review-paper-muted: rgba(36, 26, 61, 0.54);
    --review-accent: #b8701c;
    --review-brand: #4b3a8f;
    --review-border: rgba(75, 58, 143, 0.16);
  }


  .purelane-reviews {
    display: block;
    width: 100%;
    background: var(--review-bg);
    color: var(--review-paper);
    font-family:
      'Inter',
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.62;
    overflow: hidden;
    padding: 34px 0;
    box-sizing: border-box;
  }


  .purelane-reviews *,
  .purelane-reviews *::before,
  .purelane-reviews *::after {
    box-sizing: border-box;
  }


  .purelane-reviews-wrap {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 18px;
  }


  /* HEADER */

  .purelane-reviews-header {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-bottom: 18px;
    text-align: center;
  }


  .purelane-reviews-kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--review-paper-muted);
  }


  .purelane-reviews-rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--review-paper-soft);
  }


  .purelane-reviews-rating strong {
    font-size: 12px;
    color: var(--review-accent);
    letter-spacing: 0;
  }


  .purelane-reviews-stars {
    color: var(--review-accent);
    font-size: 12px;
    letter-spacing: 0.14em;
    line-height: 1;
    white-space: nowrap;
  }


  .purelane-reviews-subtitle {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--review-paper-soft);
  }


  /* RAIL */

  .purelane-reviews-rail {
    display: block;
    width: 100%;
    overflow: hidden;
    position: relative;

    -webkit-mask-image:
      linear-gradient(
        90deg,
        transparent,
        #000 7%,
        #000 93%,
        transparent
      );

    mask-image:
      linear-gradient(
        90deg,
        transparent,
        #000 7%,
        #000 93%,
        transparent
      );
  }


  .purelane-reviews-track {
    display: flex;
    align-items: stretch;
    gap: 12px;
    width: max-content;
    animation: purelaneReviewsMarquee 52s linear infinite;
    will-change: transform;
  }


  .purelane-reviews-rail:hover
  .purelane-reviews-track,

  .purelane-reviews-rail:focus-within
  .purelane-reviews-track {
    animation-play-state: paused;
  }


  @keyframes purelaneReviewsMarquee {

    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }

  }


  /* CARD */

  .purelane-review-card {
    flex: 0 0 284px;
    width: 284px;
    min-height: 190px;

    display: flex;
    flex-direction: column;

    padding: 18px 18px;

    border: 1px solid var(--review-border);
    border-radius: 26px;

    background:
      linear-gradient(
        158deg,
        rgba(255, 255, 255, 0.82),
        rgba(236, 230, 247, 0.68)
      );

    box-shadow:
      0 18px 48px rgba(58, 44, 112, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);

    color: var(--review-paper);

    overflow: hidden;
  }


  .purelane-review-stars {
    color: var(--review-accent);
    font-size: 11px;
    letter-spacing: 0.18em;
    line-height: 1.2;
    margin-bottom: 10px;
  }


  .purelane-review-title {
    margin: 0 0 8px;

    font-family:
      'Outfit',
      'Inter',
      system-ui,
      sans-serif;

    font-size: 13px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.05em;
    text-transform: uppercase;

    color: var(--review-paper);
  }


  .purelane-review-content {
    margin: 0 0 14px;

    font-size: 12.6px;
    line-height: 1.52;

    color: var(--review-paper-soft);
  }


  .purelane-review-author {
    display: flex;
    align-items: center;
    gap: 7px;

    margin-top: auto;

    font-size: 9.5px;
    font-weight: 700;
    line-height: 1.4;

    letter-spacing: 0.1em;
    text-transform: uppercase;

    color: var(--review-paper-muted);
  }


  .purelane-review-author strong {
    color: var(--review-paper);
    font-weight: 700;
  }


  .purelane-review-author span {
    color: var(--review-paper-muted);
  }


  .purelane-review-author svg {
    flex: 0 0 auto;

    width: 12px;
    height: 12px;

    color: var(--review-accent);
  }


  .purelane-reviews-empty {
    max-width: 600px;
    margin: 20px auto 0;
    padding: 30px;

    border: 1px dashed var(--review-border);
    border-radius: 18px;

    text-align: center;
    color: var(--review-paper-muted);
  }


  /* MOBILE */

  @media screen and (max-width: 760px) {

    .purelane-reviews {
      padding: 24px 0;
    }


    .purelane-reviews-wrap {
      padding: 0 14px;
    }


    .purelane-reviews-header {
      gap: 8px 12px;
      margin-bottom: 16px;
    }


    .purelane-reviews-kicker,
    .purelane-reviews-rating,
    .purelane-reviews-subtitle {
      font-size: 10px;
    }


    .purelane-review-card {
      flex-basis: 250px;
      width: 250px;
      min-height: 180px;
      padding: 15px;
      border-radius: 20px;
    }


    .purelane-reviews-track {
      animation-duration: 40s;
    }

  }


  /* ACCESSIBILITY */

  @media (prefers-reduced-motion: reduce) {

    .purelane-reviews-track {
      animation: none;
      transform: none;
    }

  }


  /* KEYBOARD FOCUS */

  .purelane-review-card a:focus-visible,
  .purelane-review-card button:focus-visible {
    outline: 3px solid var(--review-brand);
    outline-offset: 3px;
  }

</style>