        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
            "title": "Works like a charm",
            "content": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "reviewer_name": "Anita",
