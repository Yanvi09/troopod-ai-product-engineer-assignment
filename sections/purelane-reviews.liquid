{% endschema %}

{% comment %}
  Purelane Reviews Section
  Auto-scrolling marquee of customer reviews
{% endcomment %}

<link rel="stylesheet" href="{{ 'purelane.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'purelane.css' | asset_url | stylesheet_tag }}</noscript>

<section class="purelane-reviews sec" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="purelane-revhead rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      
      {% if section.settings.rating_text != blank %}
        <span class="purelane-revhead-agg">
          <span class="purelane-revhead-stars">★★★★★</span> 
          <b>{{ section.settings.rating_text }}</b>
        </span>
      {% endif %}
      
      {% if section.settings.subtitle != blank %}
        <span class="purelane-revhead-agg">Loved by <b>12 lakh+</b> homes</span>
      {% endif %}
    </div>
  </div>
  
  <div class="purelane-revrail rv" aria-label="Customer reviews">
    <div class="purelane-revtrack">
      {% for block in section.blocks %}
        <article class="purelane-rcard glass-2 rv" {{ block.shopify_attributes }}>
          <div class="purelane-rcard-stars">{{ block.settings.stars }}</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.content }}</p>
          <div class="purelane-rcard-who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m5 13 4 4L19 7"/>
            </svg>
            <b>{{ block.settings.reviewer_name }}</b>
            <span>· {{ block.settings.product_name }}</span>
          </div>
        </article>
      {% endfor %}
      
      <!-- Duplicate reviews for seamless scrolling -->
      {% assign offset = section.blocks.size %}
      {% for block in section.blocks %}
        <article class="purelane-rcard glass-2 rv" aria-hidden="true">
          <div class="purelane-rcard-stars">{{ block.settings.stars }}</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.content }}</p>
          <div class="purelane-rcard-who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="m5 13 4 4L19 7"/>
            </svg>
            <b>{{ block.settings.reviewer_name }}</b>
            <span>· {{ block.settings.product_name }}</span>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  // Initialize reveal animations for reviews section
  document.addEventListener('DOMContentLoaded', function() {
    const reviewsSection = document.querySelector('.purelane-reviews');
    if (!reviewsSection) return;

    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
        }
      });
    }, observerOptions);

    const revealElements = reviewsSection.querySelectorAll('.rv');
    revealElements.forEach(el => observer.observe(el));
  });
</script>

<style>
  /* Reviews Section Styles */
  .purelane-reviews-section {
    --ink: #f4f0fb;
    --deep: #e2daf3;
    --brand: #4b3a8f;
    --brand-lt: #6b55b8;
    --paper: #241a3d;
    --paper-2: rgba(36, 26, 61, 0.78);
    --paper-3: rgba(36, 26, 61, 0.56);
    --accent: #b8701c;
    --accent-2: #c9761d;
    --surface: #17102b;
    --g-bg: linear-gradient(158deg, rgba(255, 255, 255, 0.80), rgba(236, 230, 247, 0.56) 58%, rgba(222, 212, 240, 0.50));
    --g-line: rgba(75, 58, 143, 0.16);
    --g-shadow: 0 22px 54px rgba(58, 44, 112, 0.13);
    --g-inset: inset 0 1px 0 rgba(255, 255, 255, 0.92);
    --r: 26px;
    --r-sm: 16px;
    --maxw: 1180px;
    --sec-y: 34px;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .purelane-reviews {
    background: var(--ink);
    color: var(--paper);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.62;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  .purelane-reviews .kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper-3);
  }

  .purelane-reviews .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 18px;
  }

  .purelane-reviews .sec {
    position: relative;
    padding: var(--sec-y) 0;
  }

  .purelane-revhead {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px 18px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .purelane-revhead-agg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-2);
  }

  .purelane-revhead-agg b {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    color: var(--accent);
    letter-spacing: 0;
  }

  .purelane-revhead-stars {
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.16em;
  }

  .purelane-revrail {
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .purelane-revtrack {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: marq 52s linear infinite;
  }

  .purelane-revrail:hover .purelane-revtrack,
  .purelane-revrail:focus-within .purelane-revtrack {
    animation-play-state: paused;
  }

  @keyframes marq {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .purelane-rcard {
    flex: 0 0 auto;
    width: 284px;
    padding: 15px 17px;
    border-radius: 18px;
    background: linear-gradient(158deg, rgba(236, 230, 247, 0.10), rgba(0, 48, 46, 0.22));
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    border: 1px solid rgba(236, 230, 247, 0.16);
    border-radius: var(--r);
    box-shadow: 0 18px 48px rgba(18, 12, 34, 0.36), inset 0 1px 0 rgba(255, 255, 255, 0.16);
    position: relative;
    overflow: hidden;
  }

  .purelane-rcard-stars {
    color: var(--accent);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    margin-bottom: 9px;
  }

  .purelane-rcard h5 {
    font-family: 'Outfit', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--surface);
    margin-bottom: 7px;
  }

  .purelane-rcard p {
    font-size: 12.6px;
    color: var(--paper-2);
    line-height: 1.52;
    margin-bottom: 11px;
  }

  .purelane-rcard-who {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper-3);
  }

  .purelane-rcard-who b {
    color: var(--surface);
    font-weight: 700;
  }

  .purelane-rcard-who svg {
    width: 12px;
    height: 12px;
    color: var(--accent);
    flex: 0 0 auto;
  }

  .purelane-reviews .rv {
    opacity: 0;
    transform: translateY(30px);
    filter: blur(7px);
    transition: opacity 0.95s var(--ease), transform 0.95s var(--ease), filter 0.95s var(--ease);
  }

  .purelane-reviews .rv.in {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .purelane-reviews .rv-1 {
    transition-delay: 0.09s;
  }

  .purelane-reviews .rv-2 {
    transition-delay: 0.18s;
  }

  .purelane-reviews .rv-3 {
    transition-delay: 0.27s;
  }

  .purelane-reviews .rv-4 {
    transition-delay: 0.36s;
  }

  .purelane-reviews .rv-5 {
    transition-delay: 0.45s;
  }

  .purelane-reviews .rv-6 {
    transition-delay: 0.54s;
  }

  .purelane-reviews .rv-7 {
    transition-delay: 0.63s;
  }

  .purelane-reviews .rv-8 {
    transition-delay: 0.72s;
  }

  @media(max-width: 760px) {
    .purelane-reviews-section {
      --sec-y: 22px;
    }
    .purelane-rcard {
      width: 250px;
      padding: 13px 14px;
    }
    .purelane-revtrack {
      animation-duration: 40s;
    }
  }

  @media(prefers-reduced-motion: reduce) {
    .purelane-revtrack {
      animation: none;
    }
    .purelane-reviews * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .purelane-reviews .rv {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>