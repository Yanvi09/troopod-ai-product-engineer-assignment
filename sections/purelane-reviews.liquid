          }
        },
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
            "title": "Best dishwash ever",
            "content": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "reviewer_name": "Priya",
            "product_name": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
            "title": "Great product, great packaging",
