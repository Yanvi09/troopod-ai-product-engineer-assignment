{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clean That Lasts"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight Text",
      "default": "Lasts"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "How it works"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero"
    }
  ]
}
{% endschema %}

{% comment %}
  Purelane Hero Section
  Displays hero with product carousel and pricing
{% endcomment %}

<section class="purelane-hero" id="purelane-hero-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="hero-grid">
    
    <!-- Desktop Badges -->
    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
        </span>
        <span>Plant<br>powered</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
        </span>
        <span>Safe for<br>kids &amp; pets</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
        </span>
        <span>Zero harsh<br>chemicals</span>
      </div>
    </div>

    <!-- Hero Copy -->
    <div class="hero-copy">
      <h1 class="d1 rv in">
        {{ section.settings.heading | newline_to_br }}
        {% if section.settings.highlight_text != blank %}
          <span class="lime">{{ section.settings.highlight_text }}</span>
        {% endif %}
      </h1>
      
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
      
      {% if section.settings.subheading != blank %}
        <p class="lede rv rv-d2">{{ section.settings.subheading }}</p>
      {% endif %}
      
      <div class="hero-cta rv rv-d3">
        {% if section.settings.cta_text != blank %}
          <a class="btn btn-primary" href="{% if section.settings.cta_link != blank %}{{ section.settings.cta_link }}{% else %}#shop{% endif %}">
            {{ section.settings.cta_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
        {% endif %}
        
        {% if section.settings.secondary_cta_text != blank %}
          <a class="btn btn-ghost" href="{% if section.settings.secondary_cta_link != blank %}{{ section.settings.secondary_cta_link }}{% else %}#how{% endif %}">
            {{ section.settings.secondary_cta_text }}
          </a>
        {% endif %}
      </div>

      <!-- Mobile Badge Strip -->
      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          Plant powered
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
          Kids &amp; pet safe
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
          Zero harsh chem
        </div>
      </div>
    </div>

    <!-- Hero Product Stage -->
    <div class="hero-prod">
      <div class="hstage" id="hstage-{{ section.id }}">
        
        <!-- Slide 1: Single Product -->
        <div class="hslide hs1 on" data-n="1">
          {% if section.settings.product_1 != blank %}
            {% assign product_1 = all_products[section.settings.product_1] %}
            <span class="hp a d1" 
                  style="background-image: url('{{ product_1.featured_image | image_url: width: 600 }}');"
                  role="img" 
                  aria-label="{{ product_1.title }}">
            </span>
            <div class="glass-2 ptag">
              <span class="lbl">Single bottle</span>
              <span class="val">
                <strong>{{ product_1.price | money }}</strong>
                {% if product_1.compare_at_price > product_1.price %}
                  <s>{{ product_1.compare_at_price | money }}</s>
                {% endif %}
              </span>
              {% if product_1.compare_at_price > product_1.price %}
                {% assign savings = product_1.compare_at_price | minus: product_1.price %}
                {% assign savings_percent = savings | times: 100 | divided_by: product_1.compare_at_price %}
                <span class="cut">{{ savings_percent }}% off</span>
              {% endif %}
            </div>
          {% else %}
            <span class="hp a d1" role="img" aria-label="Product placeholder"></span>
          {% endif %}
        </div>

        <!-- Slide 2: Two Products -->
        <div class="hslide hs2" data-n="2">
          {% if section.settings.product_1 != blank %}
            <span class="hp a d1" 
                  style="background-image: url('{{ product_1.featured_image | image_url: width: 600 }}');"
                  role="img" 
                  aria-label="{{ product_1.title }}">
            </span>
          {% endif %}
          
          {% if section.settings.product_2 != blank %}
            {% assign product_2 = all_products[section.settings.product_2] %}
            <span class="hp b d2" 
                  style="background-image: url('{{ product_2.featured_image | image_url: width: 600 }}');"
                  role="img" 
                  aria-label="{{ product_2.title }}">
            </span>
            <div class="glass-2 ptag">
              <span class="lbl">Any 2 products</span>
              <span class="val">
                <strong>{% if product_1.price %}{{ product_1.price | times: 2 | money }}{% else %}₹349{% endif %}</strong>
                <s>{% if product_1.compare_at_price %}{{ product_1.compare_at_price | times: 2 | money }}{% else %}₹598{% endif %}</s>
              </span>
              <span class="cut">Save ₹249</span>
            </div>
          {% endif %}
        </div>

        <!-- Slide 3: Three Products -->
        <div class="hslide hs3" data-n="3">
          {% if section.settings.product_1 != blank %}
            <span class="hp a d1" 
                  style="background-image: url('{{ product_1.featured_image | image_url: width: 600 }}');"
                  role="img" 
                  aria-label="{{ product_1.title }}">
            </span>
          {% endif %}
          
          {% if section.settings.product_2 != blank %}
            <span class="hp b d2" 
                  style="background-image: url('{{ product_2.featured_image | image_url: width: 600 }}');"
                  role="img" 
                  aria-label="{{ product_2.title }}">
            </span>
          {% endif %}
          
          {% if section.settings.product_3 != blank %}
            {% assign product_3 = all_products[section.settings.product_3] %}
            <span class="hp c d3" 
                  style="background-image: url('{{ product_3.featured_image | image_url: width: 600 }}');"
                  role="img" 
                  aria-label="{{ product_3.title }}">
            </span>
            <div class="glass-2 ptag">
              <span class="lbl">Any 3 products</span>
              <span class="val">
                <strong>{% if product_1.price %}{{ product_1.price | times: 3 | money }}{% else %}₹499{% endif %}</strong>
                <s>{% if product_1.compare_at_price %}{{ product_1.compare_at_price | times: 3 | money }}{% else %}₹897{% endif %}</s>
              </span>
              <span class="cut">Save ₹398</span>
            </div>
          {% endif %}
        </div>
      </div>
      
      <!-- Dots Navigation -->
      <div class="hdots" id="hdots-{{ section.id }}">
        <button type="button" class="on" aria-label="Show 1 product"></button>
        <button type="button" aria-label="Show 2 products"></button>
        <button type="button" aria-label="Show 3 products"></button>
      </div>
    </div>
  </div>
</section>

<script>
  // Initialize hero functionality
  document.addEventListener('DOMContentLoaded', function() {
    const heroSection = document.querySelector('.purelane-hero');
    if (!heroSection) return;

    const stage = heroSection.querySelector('.hstage');
    const slides = heroSection.querySelectorAll('.hslide');
    const dots = heroSection.querySelectorAll('.hdots button');
    const productId = heroSection.id;

    if (!stage || slides.length === 0) return;

    let currentSlide = 0;
    const totalSlides = slides.length;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.remove('on');
        if (i === index) {
          slide.classList.add('on');
        }
      });

      dots.forEach((dot, i) => {
        dot.classList.remove('on');
        if (i === index) {
          dot.classList.add('on');
        }
      });

      currentSlide = index;
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        showSlide(index);
      });
    });

    // Auto-rotate slides
    setInterval(() => {
      const nextSlide = (currentSlide + 1) % totalSlides;
      showSlide(nextSlide);
    }, 5000);
  });
</script>