{% schema %}
{
  "name": "Purelane Shop",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show ratings"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop"
    }
  ]
}
{% endschema %}

{% comment %}
  Purelane Shop Section
  Displays product grid using reusable product card snippet
{% endcomment %}





<section class="purelane-shop sec" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="panel-head">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {% endif %}
      
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
    </div>

    <div class="purelane-shelf">
      <!-- Debug: Collection selected: {{ section.settings.collection }} -->
      <!-- Debug: Products to show: {{ section.settings.products_to_show }} -->
      
      {% if section.settings.collection != blank %}
        {% assign collection = collections[section.settings.collection] %}
        <!-- Debug: Collection found: {{ collection.title }} -->
        <!-- Debug: Collection products count: {{ collection.products.size }} -->
      {% else %}
        {% assign collection = collections.all %}
        <!-- Debug: Using all products -->
      %}

      {% if collection.products.size > 0 %}
        <!-- Debug: Looping through products -->
        {% for product in collection.products limit: section.settings.products_to_show %}
          <!-- Debug: Product {{ forloop.index }}: {{ product.title }} -->
          {% assign badge_text = '' %}
          {% if forloop.first == true %}
            {% assign badge_text = 'Best seller' %}
          {% elsif forloop.index == 3 %}
            {% assign badge_text = 'Top rated' %}
          {% elsif forloop.index == 4 %}
            {% assign badge_text = 'New' %}
          {% endif %}

          <div class="purelane-shelf-item">
            {% render 'product-card',
              product: product,
              badge_text: badge_text,
              show_rating: section.settings.show_rating
            %}
          </div>
        {% endfor %}
      {% else %}
        <p style="background: red; color: white; padding: 20px;">No products found in collection.</p>
      {% endif %}
    </div>
  </div>
</section>


<style>
  /* Shop Section Styles - Simplified */
  .purelane-shop-section {
    --ink: #f4f0fb;
    --paper: #241a3d;
    --accent: #b8701c;
    --surface: #17102b;
    --g-bg: linear-gradient(158deg, rgba(255, 255, 255, 0.80), rgba(236, 230, 247, 0.56) 58%, rgba(222, 212, 240, 0.50));
    --g-line: rgba(75, 58, 143, 0.16);
    --g-shadow: 0 22px 54px rgba(58, 44, 112, 0.13);
    --r: 26px;
    --maxw: 1180px;
    --sec-y: 34px;
  }

  .purelane-shop {
    background: var(--ink);
    color: var(--paper);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.62;
    padding: var(--sec-y) 0;
  }

  .purelane-shop .d2 {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(30px, 4.6vw, 54px);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--surface);
  }

  .purelane-shop .kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(36, 26, 61, 0.56);
  }

  .purelane-shop .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 18px;
  }

  .purelane-shop .panel-head {
    text-align: center;
    margin-bottom: 26px;
  }

  .purelane-shop .rule {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 12px auto 0;
    max-width: 240px;
  }

  .purelane-shop .rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, rgba(75, 58, 143, 0.34));
  }

  .purelane-shop .rule svg {
    width: 16px;
    height: 16px;
    color: var(--accent);
    flex: 0 0 auto;
  }

  .purelane-shelf {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
  }

  @media(min-width: 860px) {
    .purelane-shelf {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>