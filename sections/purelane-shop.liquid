{% schema %}
{
  "name": "Purelane Shop",
  "tag": "section",
  "class": "purelane-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show ratings"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop"
    }
  ]
}
{% endschema %}

{% comment %}
  Purelane Shop Section
  Displays product grid using reusable product card snippet
{% endcomment %}





<section class="purelane-shop sec" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="panel-head rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {% endif %}
      
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>
    </div>

    <div class="purelane-shelf">
      {% if section.settings.collection != blank %}
        {% assign collection = collections[section.settings.collection] %}
      {% else %}
        {% assign collection = collections.all %}
      %}

      {% for product in collection.products limit: section.settings.products_to_show %}
        {% assign badge_text = '' %}
        {% if forloop.first == true %}
          {% assign badge_text = 'Best seller' %}
        {% elsif forloop.index == 3 %}
          {% assign badge_text = 'Top rated' %}
        {% elsif forloop.index == 4 %}
          {% assign badge_text = 'New' %}
        {% endif %}

        <div class="purelane-shelf-item rv rv-{{ forloop.index }}">
          {% render 'product-card',
            product: product,
            badge_text: badge_text,
            show_rating: section.settings.show_rating
          %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  // Initialize reveal animations for shop section
  document.addEventListener('DOMContentLoaded', function() {
    const shopSection = document.querySelector('.purelane-shop');
    if (!shopSection) return;

    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
        }
      });
    }, observerOptions);

    const revealElements = shopSection.querySelectorAll('.rv');
    revealElements.forEach(el => observer.observe(el));
  });
</script>

<style>
  /* Shop Section Styles */
  .purelane-shop-section {
    --ink: #f4f0fb;
    --deep: #e2daf3;
    --brand: #4b3a8f;
    --brand-lt: #6b55b8;
    --paper: #241a3d;
    --paper-2: rgba(36, 26, 61, 0.78);
    --paper-3: rgba(36, 26, 61, 0.56);
    --accent: #b8701c;
    --accent-2: #c9761d;
    --surface: #17102b;
    --g-bg: linear-gradient(158deg, rgba(255, 255, 255, 0.80), rgba(236, 230, 247, 0.56) 58%, rgba(222, 212, 240, 0.50));
    --g-line: rgba(75, 58, 143, 0.16);
    --g-shadow: 0 22px 54px rgba(58, 44, 112, 0.13);
    --g-inset: inset 0 1px 0 rgba(255, 255, 255, 0.92);
    --r: 26px;
    --r-sm: 16px;
    --maxw: 1180px;
    --sec-y: 34px;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .purelane-shop {
    background: var(--ink);
    color: var(--paper);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.62;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }

  .purelane-shop .d1, 
  .purelane-shop .d2, 
  .purelane-shop .d3, 
  .purelane-shop .d4 {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.018em;
    font-weight: 800;
    line-height: 0.87;
    color: var(--surface);
  }

  .purelane-shop .d2 {
    font-size: clamp(30px, 4.6vw, 54px);
    line-height: 0.94;
  }

  .purelane-shop .kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper-3);
  }

  .purelane-shop .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 18px;
  }

  .purelane-shop .sec {
    position: relative;
    padding: var(--sec-y) 0;
  }

  .purelane-shop .panel-head {
    text-align: center;
    margin-bottom: 26px;
  }

  .purelane-shop .panel-head .d2 {
    margin-bottom: 12px;
  }

  .purelane-shop .panel-head .rule {
    margin: 0 auto;
    justify-content: center;
    max-width: 240px;
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .purelane-shop .panel-head .rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, rgba(75, 58, 143, 0.34));
  }

  .purelane-shop .panel-head .rule svg {
    width: 16px;
    height: 16px;
    color: var(--accent);
    flex: 0 0 auto;
  }

  .purelane-shop .rule {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 0 0 20px;
    max-width: 270px;
  }

  .purelane-shop .rule i {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, rgba(75, 58, 143, 0.34), transparent);
  }

  .purelane-shop .rule svg {
    width: 16px;
    height: 16px;
    color: var(--accent);
    flex: 0 0 auto;
  }

  .purelane-shop .rv {
    opacity: 0;
    transform: translateY(30px);
    filter: blur(7px);
    transition: opacity 0.95s var(--ease), transform 0.95s var(--ease), filter 0.95s var(--ease);
  }

  .purelane-shop .rv.in {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .purelane-shop .rv-1 {
    transition-delay: 0.09s;
  }

  .purelane-shop .rv-2 {
    transition-delay: 0.18s;
  }

  .purelane-shop .rv-3 {
    transition-delay: 0.27s;
  }

  .purelane-shop .rv-4 {
    transition-delay: 0.36s;
  }

  .purelane-shop .rv-5 {
    transition-delay: 0.45s;
  }

  .purelane-shop .rv-6 {
    transition-delay: 0.54s;
  }

  .purelane-shop .rv-7 {
    transition-delay: 0.63s;
  }

  .purelane-shop .rv-8 {
    transition-delay: 0.72s;
  }

  .purelane-shelf {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media(min-width: 860px) {
    .purelane-shelf {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media(max-width: 760px) {
    .purelane-shop-section {
      --sec-y: 22px;
    }
  }

  @media(prefers-reduced-motion: reduce) {
    .purelane-shop * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .purelane-shop .rv {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>