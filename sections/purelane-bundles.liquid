{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "purelane-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "number",
          "id": "product_count",
          "label": "Number of products",
          "default": 2
        },
        {
          "type": "number",
          "id": "price",
          "label": "Bundle price",
          "default": 349
        },
        {
          "type": "number",
          "id": "compare_price",
          "label": "Compare price",
          "default": 598
        },
        {
          "type": "text",
          "id": "per_product_text",
          "label": "Per product text",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured tier",
          "default": false
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "info": "Enter one feature per line.",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "product_count": 2,
            "price": 349,
            "compare_price": 598,
            "per_product_text": "Flat ₹174 per product",
            "featured": false,
            "features": "Pick any two products\nFree shipping across India",
            "cta_text": "Build this box"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "product_count": 3,
            "price": 499,
            "compare_price": 897,
            "per_product_text": "Flat ₹166 per product",
            "featured": true,
            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",
            "cta_text": "Build this box"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "product_count": 5,
            "price": 799,
            "compare_price": 1495,
            "per_product_text": "Flat ₹160 per product",
            "featured": false,
            "features": "Pick any five products\nEvery room in one order\nFree shipping across India",
            "cta_text": "Build this box"
          }
        }
      ]
    }
  ]
}
{% endschema %}


<section class="purelane-bundles" id="bundles">

  <div class="purelane-bundles-container">

    {% if section.settings.kicker != blank %}
      <span class="purelane-bundles-kicker">
        {{ section.settings.kicker }}
      </span>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="purelane-bundles-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="purelane-bundles-description">
        {{ section.settings.description }}
      </p>
    {% endif %}


    <div class="purelane-bundles-grid">

      {% for block in section.blocks %}

        {% assign saving = block.settings.compare_price | minus: block.settings.price %}

        <article
          class="
            purelane-bundle-card
            {% if block.settings.featured %}
              purelane-bundle-card--featured
            {% endif %}
          "
          {{ block.shopify_attributes }}
        >

          {% if block.settings.tag != blank %}
            <div class="purelane-bundle-tag">
              {{ block.settings.tag }}
            </div>
          {% endif %}


          <div class="purelane-bundle-icon" aria-hidden="true">

            {% if block.settings.product_count == 2 %}

              <div class="bundle-box bundle-box--two">
                <span></span>
                <span></span>
              </div>

            {% elsif block.settings.product_count == 3 %}

              <div class="bundle-box bundle-box--three">
                <span></span>
                <span></span>
                <span></span>
              </div>

            {% else %}

              <div class="bundle-box bundle-box--five">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </div>

            {% endif %}

          </div>


          <div class="purelane-bundle-count">
            <strong>{{ block.settings.product_count }}</strong>
            <span>Products</span>
          </div>


          <div class="purelane-bundle-price">

            <strong>
              {{ block.settings.price | times: 100 | money_without_trailing_zeros }}
            </strong>

            {% if block.settings.compare_price > block.settings.price %}
              <s>
                {{ block.settings.compare_price | times: 100 | money_without_trailing_zeros }}
              </s>
            {% endif %}

          </div>


          {% if block.settings.per_product_text != blank %}
            <p class="purelane-bundle-per-product">
              {{ block.settings.per_product_text }}
            </p>
          {% endif %}


          {% if block.settings.features != blank %}

            <ul class="purelane-bundle-features">

              {% assign features = block.settings.features | newline_to_br | split: '<br />' %}

              {% for feature in features %}

                {% assign clean_feature = feature | strip %}

                {% if clean_feature != blank %}

                  <li>
                    <span class="purelane-check" aria-hidden="true">
                      ✓
                    </span>

                    <span>
                      {{ clean_feature }}
                    </span>
                  </li>

                {% endif %}

              {% endfor %}

            </ul>

          {% endif %}


          {% if block.settings.cta_link != blank %}

            <a
              href="{{ block.settings.cta_link }}"
              class="purelane-bundle-button"
            >
              {{ block.settings.cta_text }}
              <span aria-hidden="true">→</span>
            </a>

          {% else %}

            <a
              href="#shop"
              class="purelane-bundle-button"
            >
              {{ block.settings.cta_text }}
              <span aria-hidden="true">→</span>
            </a>

          {% endif %}

        </article>

      {% endfor %}

    </div>

  </div>

</section>


<style>

  .purelane-bundles {
    background: #f4f0fb;
    padding: 80px 20px;
    color: #241a3d;
  }


  .purelane-bundles-container {
    max-width: 1180px;
    margin: 0 auto;
  }


  .purelane-bundles-kicker {
    display: block;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 12px;
    font-weight: 800;
    color: #7d7691;
    margin-bottom: 12px;
  }


  .purelane-bundles-heading {
    margin: 0;
    text-align: center;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
  }


  .purelane-bundles-description {
    max-width: 650px;
    margin: 18px auto 45px;
    text-align: center;
    color: #77718b;
    font-size: 16px;
    line-height: 1.7;
  }


  .purelane-bundles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }


  .purelane-bundle-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 30px;
    min-height: 470px;
    border: 1px solid rgba(75, 58, 143, 0.16);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 15px 45px rgba(52, 36, 93, 0.08);
  }


  .purelane-bundle-card--featured {
    border-color: #4b3a8f;
    box-shadow: 0 20px 55px rgba(75, 58, 143, 0.17);
    transform: translateY(-8px);
  }


  .purelane-bundle-tag {
    align-self: flex-start;
    padding: 7px 13px;
    border-radius: 999px;
    background: #ebe6f8;
    color: #4b3a8f;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }


  .purelane-bundle-card--featured .purelane-bundle-tag {
    background: #4b3a8f;
    color: white;
  }


  .purelane-bundle-icon {
    height: 150px;
    margin: 20px 0 15px;
    display: flex;
    justify-content: center;
    align-items: center;
  }


  .bundle-box {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 7px;
    height: 120px;
  }


  .bundle-box span {
    display: block;
    width: 38px;
    height: 90px;
    border-radius: 8px 8px 5px 5px;
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #ebe7f5 100%
    );
    border: 1px solid rgba(75, 58, 143, 0.18);
    box-shadow: 0 8px 18px rgba(36, 26, 61, 0.12);
  }


  .bundle-box span::after {
    content: "";
    display: block;
    width: 70%;
    height: 35%;
    margin: 32px auto 0;
    border-radius: 4px;
    background: #4b3a8f;
    opacity: 0.75;
  }


  .bundle-box--two span:nth-child(1) {
    height: 82px;
  }

  .bundle-box--two span:nth-child(2) {
    height: 105px;
  }


  .bundle-box--three span:nth-child(1) {
    height: 82px;
  }

  .bundle-box--three span:nth-child(2) {
    height: 110px;
  }

  .bundle-box--three span:nth-child(3) {
    height: 90px;
  }


  .bundle-box--five span {
    width: 30px;
  }

  .bundle-box--five span:nth-child(1),
  .bundle-box--five span:nth-child(4) {
    height: 76px;
  }

  .bundle-box--five span:nth-child(2),
  .bundle-box--five span:nth-child(5) {
    height: 92px;
  }

  .bundle-box--five span:nth-child(3) {
    height: 112px;
  }


  .purelane-bundle-count {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-bottom: 12px;
  }


  .purelane-bundle-count strong {
    font-size: 19px;
    font-weight: 800;
  }


  .purelane-bundle-count span {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #858095;
    font-weight: 700;
  }


  .purelane-bundle-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }


  .purelane-bundle-price strong {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.04em;
  }


  .purelane-bundle-price s {
    font-size: 15px;
    color: #8b8499;
  }


  .purelane-bundle-per-product {
    margin: 6px 0 22px;
    color: #77718b;
    font-size: 12px;
  }


  .purelane-bundle-features {
    list-style: none;
    margin: 0 0 25px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }


  .purelane-bundle-features li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: #5d576e;
    font-size: 14px;
    line-height: 1.4;
  }


  .purelane-check {
    flex: 0 0 auto;
    color: #4b3a8f;
    font-weight: 900;
  }


  .purelane-bundle-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-top: auto;
    padding: 14px 20px;
    border: 1px solid rgba(75, 58, 143, 0.25);
    border-radius: 999px;
    background: transparent;
    color: #241a3d;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }


  .purelane-bundle-button:hover {
    background: #4b3a8f;
    color: white;
    transform: translateY(-2px);
  }


  @media (max-width: 900px) {

    .purelane-bundles-grid {
      grid-template-columns: 1fr;
      max-width: 600px;
      margin: 0 auto;
    }

    .purelane-bundle-card--featured {
      transform: none;
    }

  }


  @media (max-width: 600px) {

    .purelane-bundles {
      padding: 55px 16px;
    }

    .purelane-bundle-card {
      padding: 24px;
      min-height: auto;
    }

    .purelane-bundles-description {
      font-size: 14px;
      margin-bottom: 30px;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .purelane-bundle-button {
      transition: none;
    }

  }

</style>